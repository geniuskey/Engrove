# Local development values only. Replace every credential in production.
NODE_ENV=development
ENGROVE_VERSION=0.1.0
ENGROVE_PUBLIC_URL=http://localhost:4173
ENGROVE_API_PORT=3000
ENGROVE_WEB_PORT=4173
ENGROVE_SETUP_TOKEN=engrove_setup_dev_only_token_32_chars
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=168
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
VITE_API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://engrove:engrove_dev_only@localhost:5432/engrove
DATABASE_MIGRATION_URL=postgresql://engrove:engrove_dev_only@localhost:5432/engrove
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=engrove-development
S3_ACCESS_KEY_ID=engrove_dev
S3_SECRET_ACCESS_KEY=engrove_dev_only
S3_FORCE_PATH_STYLE=true
PYTHON_WORKER_BASE_URL=http://localhost:8000
INTERNAL_SERVICE_SECRET=engrove_internal_dev_only
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_ALLOWED_DOMAINS=
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_ROLE=viewer
LOG_LEVEL=info
